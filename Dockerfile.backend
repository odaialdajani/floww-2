FROM python:3.12-slim AS production

WORKDIR /app

# Install dependencies.
# torch is ONLY used by backend/tests/* (never imported by server.py or any
# service at runtime) and adds ~1GB+ to the image for zero runtime benefit.
# Exclude it from the production image; local dev/test venvs still install it
# from requirements.txt directly.
COPY backend/requirements.txt .
RUN grep -Ev '^\s*torch' requirements.txt > /tmp/req.prod.txt \
    && pip install --no-cache-dir -r /tmp/req.prod.txt \
    && rm /tmp/req.prod.txt

# Copy backend code
COPY backend/ .

# Create non-root user
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Run
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
