{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --rebase origin main)",
      "Bash(git push origin main)",
      "Bash(git add backend/:*)",
      "Bash(git add frontend/:*)",
      "Bash(git add docs/:*)",
      "Bash(git add kanban/:*)",
      "Bash(git add scripts/:*)",
      "Bash(git add qc/:*)",
      "Bash(git add .planning/:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git checkout backend/:*)",
      "Bash(git checkout frontend/:*)",
      "Bash(git checkout docs/:*)",
      "Bash(grep:*)",
      "Bash(find . -:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(test:*)",
      "Bash(mkdir:*)",
      "Bash(curl:*)",
      "Bash(date:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(backend/.venv313/Scripts/python.exe:*)",
      "Bash(cd backend && ./.venv313/Scripts/python.exe:*)",
      "Bash(cd backend && .venv313/Scripts/python.exe:*)",
      "Bash(cd frontend && npm:*)",
      "Bash(cd frontend && npx:*)",
      "Bash(cd frontend && CI=true:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(cargo check:*)",
      "Bash(bash qc/:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -df:*)",
      "Bash(git clean -f:*)",
      "Bash(git rebase -i:*)",
      "Bash(git rebase --abort:*)",
      "Bash(git add -A:*)",
      "Bash(git add .)",
      "Bash(git add --all:*)",
      "Edit(backend/services/ml/inference.py)",
      "Write(backend/services/ml/inference.py)",
      "Edit(backend/services/dash_ui.py)",
      "Write(backend/services/dash_ui.py)",
      "Edit(frontend/src/App.js)",
      "Write(frontend/src/App.js)",
      "Edit(frontend/.env)",
      "Write(frontend/.env)",
      "Edit(frontend/package.json)",
      "Write(frontend/package.json)",
      "Edit(frontend/craco.config.js)",
      "Write(frontend/craco.config.js)",
      "Edit(backend/models/**)",
      "Write(backend/models/**)",
      "Edit(models/**)",
      "Write(models/**)",
      "Edit(project_oracle/models/**)",
      "Write(project_oracle/models/**)",
      "Edit(data/github-repos/**)",
      "Write(data/github-repos/**)"
    ]
  },
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== floww session start ===' && pwd && git fetch origin 2>/dev/null; git log origin/main --oneline -3 2>/dev/null; git status --short 2>/dev/null | head -10; echo '=== phase tracking (authoritative) ==='; if [ -f .planning/STATE.md ]; then sed -n '/^## Current phase/,/^$/p' .planning/STATE.md | head -6; else echo '.planning/STATE.md missing'; fi; echo '=== backend interpreter ==='; if [ -x backend/.venv313/Scripts/python.exe ]; then backend/.venv313/Scripts/python.exe --version; else echo 'WARNING: backend/.venv313 missing - see CLAUDE.md'; fi"
          }
        ]
      }
    ]
  }
}
